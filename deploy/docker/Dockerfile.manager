# BORRADOR sin construir (2026-10-06). Contexto: la raíz de este repo.
FROM python:3.12-slim
RUN useradd --system --uid 995 --create-home acm && mkdir -p /data /opt/acserver && chown acm:acm /data /opt/acserver
WORKDIR /srv/acm
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir .
USER acm
ENV ACM_DATA_DIR=/data ACM_HOST=127.0.0.1 ACM_PORT=8080 ACM_SERVE_UI=false ACM_LIMITS_SCOPE=
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8080"]
